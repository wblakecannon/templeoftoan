# Public site URL used for metadata, canonical links, and sitemap generation.
# Set to https://dev.templeoftoan.com on the development deployment.
NEXT_PUBLIC_SITE_URL=https://www.templeoftoan.com

# Search engine indexing is opt-in and defaults to disabled everywhere.
# Set to "true" ONLY on the real production deployment
# (https://www.templeoftoan.com). Leave unset/false on dev, preview, and
# local environments so robots.txt, sitemap.xml, meta robots tags, and
# the X-Robots-Tag header all block crawling by default.
NEXT_PUBLIC_ENABLE_INDEXING=false

# Google Analytics (gtag.js) — opt-in, prod www only. Set BOTH variables
# ONLY on the real production deployment (https://www.templeoftoan.com).
# Leave unset on dev, preview, and local so GA never fires on
# non-production traffic. These are build-time-inlined (NEXT_PUBLIC_*), so
# they must be present in the Amplify build environment, not injected at
# runtime.
#
# Beyond this build-time flag, analytics also self-gate at runtime to the
# explicit production hosts (templeoftoan.com / www.templeoftoan.com)
# in src/lib/analytics/ga.ts, so even a prod build served from another host
# sends nothing. To silence your own visits on the live site, run this in the
# browser console: localStorage.setItem("toan_analytics_opt_out", "1")
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Submissions (/submit) ---
# Each of the three services below picks its adapter automatically based
# on which variables are set — there is no explicit "provider" switch.
# Leave everything in this section unset to use the safe defaults:
# local-disk uploads (.local-uploads/, gitignored) + console-logged
# submissions. See docs/submission-moderation.md.

# GitHub Issues adapter — set all three to file submissions as issues in
# a PRIVATE repository instead of logging them to the server console.
# Target repo: https://github.com/wblakecannon/templeoftoan
# GITHUB_TOKEN=
# GITHUB_OWNER=wblakecannon
# GITHUB_REPO=templeoftoan
# GITHUB_SUBMISSION_LABEL=submission:new

# S3 media upload adapter — set to store raw submission photos in a
# private S3 bucket instead of local disk. Photos upload directly from
# the browser to S3 via short-lived presigned PUT URLs (never through
# this app's server request body — Lambda's payload ceiling is far too
# small for photos), so the bucket needs a CORS policy allowing PUT from
# this site's origin(s), or every presigned upload will fail in the
# browser with a CORS error despite a valid signature. AWS credentials
# for minting presigned URLs come from the standard AWS SDK credential
# chain (the Amplify compute role's IAM policy in production), not an
# env var here. Both buckets use Object Ownership = BucketOwnerEnforced,
# so uploads must never set an ACL.
#
# Note: this uses SUBMISSION_MEDIA_BUCKET_REGION, not AWS_REGION — the
# AWS_ prefix is reserved by the hosting platform (Lambda injects its
# own AWS_REGION at runtime; Amplify won't even let you set one), so
# this app defines its own variable name instead.
#
# development branch (dev.templeoftoan.com):
# SUBMISSION_MEDIA_BUCKET=templeoftoan-dev
#
# main branch (www.templeoftoan.com):
# SUBMISSION_MEDIA_BUCKET=templeoftoan-prod
#
# SUBMISSION_MEDIA_BUCKET_REGION=us-west-2

# Submission upload limits (defaults shown; override if needed).
# SUBMISSION_MAX_FILES=6
# SUBMISSION_MAX_FILE_BYTES=20971520
# SUBMISSION_MAX_TOTAL_BYTES=83886080
# SUBMISSION_MAX_GPX_FILE_BYTES=5242880
